APP_NAME=API Perpustakaan
APP_PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=perpustakaan
DB_SSLMODE=disable
DB_MAX_CONNS=10

JWT_SECRET=          # generate: openssl rand -hex 32 (minimal 32 karakter)
JWT_ISSUER=api-perpustakaan
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
